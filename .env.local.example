# Jira Cloud REST API v3 (Basic auth: email + API token)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Local SQLite database (Prisma)
DATABASE_URL=file:./dev.db

# Voyage AI (embeddings for the knowledge-ingestion pipeline)
VOYAGE_API_KEY=pa-your-voyage-key-here
VOYAGE_MODEL=voyage-3-lite

# Local folder for PDFs/markdown SOPs to ingest
KNOWLEDGE_LOCAL_DIR=./knowledge
