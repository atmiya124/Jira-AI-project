# Jira Cloud REST API v3 (Basic auth: email + API token)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Postgres (Prisma). Use the pooled (pgbouncer) URL for DATABASE_URL and an
# unpooled URL for DIRECT_URL (Prisma migrations need a direct connection).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# Voyage AI (embeddings for the knowledge-ingestion pipeline)
VOYAGE_API_KEY=pa-your-voyage-key-here
VOYAGE_MODEL=voyage-3-lite

# Local folder for PDFs/markdown SOPs to ingest
KNOWLEDGE_LOCAL_DIR=./knowledge

# Which JiraProvider implementation to use: "twg" (local dev, default) or
# "oauth" (production - no TWG CLI dependency). Never inferred from NODE_ENV.
JIRA_PROVIDER=twg

# Atlassian OAuth 2.0 (3LO) app credentials - only required when
# JIRA_PROVIDER=oauth. Create the app at developer.atlassian.com/console,
# add the Jira API with scopes: offline_access, read:jira-work (classic),
# and the granular write bundle write:comment:jira, read:comment:jira,
# read:comment.property:jira, read:group:jira, read:project:jira,
# read:project-role:jira, read:user:jira, read:avatar:jira. Set the callback
# URL below as its redirect URI.
ATLASSIAN_CLIENT_ID=your_oauth_client_id_here
ATLASSIAN_CLIENT_SECRET=your_oauth_client_secret_here
ATLASSIAN_REDIRECT_URI=http://localhost:3000/api/auth/atlassian/callback

# Shared secret this app requires on incoming Jira webhook requests
# (?secret=... query param). Only relevant once a webhook is registered in
# Jira pointing at /api/webhooks/jira - generate a long random value.
JIRA_WEBHOOK_SECRET=your_long_random_webhook_secret_here
