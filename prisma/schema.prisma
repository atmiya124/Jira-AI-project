generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Analysis {
  id                  String    @id @default(cuid())

  ticketKey           String
  ticketUrl           String
  ticketSummary       String
  ticketDescription   String
  ticketStatus        String?
  ticketType          String?

  model               String

  pipelineType        String    @default("legacy") // "legacy" | "rag"
  triggerSource        String    @default("manual") // "manual" | "auto"

  analysisJson         String?
  draftComment         String
  estimatedComplexity  String?

  // Phase 6: populated only for pipelineType "rag" rows
  enrichedRequestJson  String?
  retrievalContextJson String?
  groundedResponseJson String?
  confidence           String?

  createdAt           DateTime  @default(now())
  reviewedAt           DateTime?
  commentPosted        Boolean   @default(false)
  commentPostedAt      DateTime?
  jiraCommentId         String?

  // Set to ticketKey ONLY when pipelineType="rag" && triggerSource="auto",
  // left null otherwise. Postgres treats multiple NULLs as non-colliding
  // under a UNIQUE constraint, so this enforces "at most one auto-RAG
  // analysis per ticket" at the database level (race-safe against
  // concurrent webhook deliveries/watcher overlap) without constraining
  // manual re-analysis versioning, which intentionally allows multiple rows
  // per ticketKey.
  autoDedupeKey        String?   @unique

  @@index([ticketKey])
  @@index([createdAt])
}

// Singleton row (fixed id "default") holding this app's Atlassian OAuth
// tokens for the production JiraProvider. Personal/single-tenant tool, so
// one row is sufficient - no per-user table needed.
model AtlassianOAuthToken {
  id           String   @id @default("default")

  accessToken  String
  refreshToken String
  cloudId      String
  siteUrl      String

  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

model KnowledgeDocument {
  id          String   @id @default(cuid())

  source      String
  sourceId    String
  title       String
  sourceUrl   String?
  updatedAt   DateTime?
  contentHash String
  ingestedAt  DateTime @default(now())

  chunks      KnowledgeChunk[]

  @@unique([source, sourceId], name: "source_sourceId")
}

model KnowledgeChunk {
  id             String   @id @default(cuid())

  documentId     String
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex     Int
  section        String?
  text           String
  tokenCount     Int?

  embedding      String
  embeddingModel String

  createdAt      DateTime @default(now())

  @@index([documentId])
}
